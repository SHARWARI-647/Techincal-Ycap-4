import java.util.Scanner;

public class frequency {
   
    //13) Print the characters of a string in sorted order
    public static void sortedOrder(String s) {
       int[] char_code=new int[s.length()];
       for(int i=0;i<s.length();i++){
           char_code[i]=s.charAt(i);
       }
       for(int i=0;i<char_code.length-1;i++){
           for(int j=i+1;j<char_code.length;j++){
               if(char_code[i]>char_code[j]){
                   int temp=char_code[i];
                   char_code[i]=char_code[j];
                   char_code[j]=temp;
               }
           }
       }
        for(int i=0;i<char_code.length;i++){
            System.out.print((char)char_code[i]+"\t");
         }
    }
    
        public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        System.out.print("Enter string: ");
        String s = sc.nextLine();

       sortedOrder(s);
           
    }
}
